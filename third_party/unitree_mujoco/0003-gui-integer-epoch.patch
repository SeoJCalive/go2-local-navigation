@@ -0,0 +1,20 @@
+// Purpose: publish physics time from integer epoch steps instead of accumulated
+// double additions. Both GUI stepping sites and the acceptance driver use this.
+// An external reset/history seek changes data->time; rebase the counter before
+// advancing. Call with the simulation mutex held when data is shared with UI.
+// Input/output: model timestep, mutable data and caller-owned epoch counter.
+#pragma once
+#include <cmath>
+#include <cstdint>
+#include <mujoco/mujoco.h>
+
+inline void step_epoch(const mjModel *model, mjData *data, std::uint64_t &steps)
+{
+  if (data->time != static_cast<double>(steps) * model->opt.timestep) {
+    steps = static_cast<std::uint64_t>(
+      std::llround(data->time / model->opt.timestep));
+  }
+  mj_step(model, data);
+  data->time = static_cast<double>(++steps) * model->opt.timestep;
+}
+
