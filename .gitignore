# 목적: ROS/Python 및 private dependency 산출물을 source Git에서 분리한다.
# 흐름/입출력: 경로 패턴 → Git 추적 제외. 고유 실행 증거는 별도 보존 규칙을 따른다.
# 주의: ignore는 파일 삭제나 증거 폐기 승인이 아니다.
# ROS 2 and Python build products
/build/
/install/
/log/
/third_party/tf2/build/
/third_party/tf2/install/
/third_party/tf2/log/
/third_party/slam_toolbox/build/
/third_party/slam_toolbox/install/
/third_party/slam_toolbox/log/
/runs/
**/__pycache__/
**/.pytest_cache/
*.py[cod]

# Runtime data and large recordings
/data/*
!/data/README.md
/data/external/dimos_go2_indoor/source/
/data/external/dimos_go2_indoor/staging/
/data/external/dimos_go2_indoor/derived/
/data/external/dimos_go2_indoor/runs/
*.bag
*.db3
*.mcap
*.sqlite3

# Local environment and editor files
.env
.env.*
.venv/
.python_deps/
.idea/
.vscode/

# Agent-local verification evidence
/.omo/
/.user/
