<mujoco model="go2_local_navigation_indoor">
  <include file="@GO2_XML@" />
  <compiler meshdir="@GO2_ASSETS@" />

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" />
  </visual>

  <worldbody>
    <geom name="indoor_floor_6m" type="plane" size="3 3 0.1" rgba="0.25 0.25 0.25 1" />
    <geom name="indoor_wall_north" type="box" pos="0 2.95 1" size="3 0.05 1" />
    <geom name="indoor_wall_south" type="box" pos="0 -2.95 1" size="3 0.05 1" />
    <geom name="indoor_wall_east" type="box" pos="2.95 0 1" size="0.05 3 1" />
    <geom name="indoor_wall_west" type="box" pos="-2.95 0 1" size="0.05 3 1" />
    <geom name="indoor_l_wall_horizontal" type="box" pos="0.9 1.3 0.75" size="0.8 0.05 0.75" />
    <geom name="indoor_l_wall_vertical" type="box" pos="1.65 0.65 0.75" size="0.05 0.7 0.75" />
    <geom name="indoor_box_pillar" type="box" pos="-1.3 0.9 0.75" size="0.35 0.35 0.75" />
    <light name="indoor_ceiling_light" pos="0 0 2.8" dir="0 0 -1" directional="true" />
  </worldbody>
</mujoco>
