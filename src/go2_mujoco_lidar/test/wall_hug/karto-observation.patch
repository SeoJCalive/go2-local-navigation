+// Observation only: selected raw scans and actual graph edges, without changing
+// matching, acceptance, covariances, graph structure, or optimization.
+namespace
+{
+thread_local bool g02LoopLinkActive = false;
+
+void g02RecordScan(LocalizedRangeScan * scan)
+{
+  const char * path = std::getenv("G02_SCAN_EVIDENCE");
+  if (path == nullptr) {return;}
+  static std::ofstream out(path);
+  const auto laser = scan->GetLaserRangeFinder();
+  const auto pose = scan->GetSensorPose();
+  out << std::setprecision(17) << "{\"scan_id\":" << scan->GetStateId()
+      << ",\"time\":" << scan->GetTime()
+      << ",\"sensor_pose\":[" << pose.GetX() << "," << pose.GetY() << ","
+      << pose.GetHeading() << "],\"angle_min\":" << laser->GetMinimumAngle()
+      << ",\"angle_increment\":" << laser->GetAngularResolution()
+      << ",\"range_min\":" << laser->GetMinimumRange()
+      << ",\"range_max\":" << laser->GetRangeThreshold() << ",\"ranges\":[";
+  const auto ranges = scan->GetRangeReadings();
+  for (kt_int32u i = 0; i < scan->GetNumberOfRangeReadings(); ++i) {
+    if (i != 0) {out << ",";}
+    if (std::isfinite(ranges[i])) {out << ranges[i];} else {out << "null";}
+  }
+  out << "]}\n";
+  out.flush();
+}
+
+void g02RecordEdge(LocalizedRangeScan * from, LocalizedRangeScan * to,
+  const Pose2 & mean, bool isNew)
+{
+  const char * path = std::getenv("G02_EDGE_EVIDENCE");
+  if (path == nullptr) {return;}
+  static std::ofstream out(path);
+  out << std::setprecision(17) << "{\"from_scan_id\":" << from->GetStateId()
+      << ",\"from_time\":" << from->GetTime()
+      << ",\"to_scan_id\":" << to->GetStateId() << ",\"to_time\":" << to->GetTime()
+      << ",\"loop\":" << (g02LoopLinkActive ? "true" : "false")
+      << ",\"new_edge\":" << (isNew ? "true" : "false")
+      << ",\"match_sensor_pose\":[" << mean.GetX() << "," << mean.GetY() << ","
+      << mean.GetHeading() << "]}\n";
+  out.flush();
+}
+}
